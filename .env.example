# ==========================================
# AI 小说创作台 部署环境变量示例
# ==========================================
# 复制为 .env 后按需修改：cp .env.example .env
# .env 已被 .gitignore 忽略，请勿提交真实密钥

# ==========================================
# 端口与站点地址
# ==========================================
APP_PORT=8090
FRONTEND_URL=http://localhost:8090
TZ=Asia/Shanghai

# ==========================================
# 品牌配置
# ==========================================
APP_NAME=AI 小说创作台
APP_VERSION=1.5.8
APP_SLOGAN=只做创作台的自托管 AI 小说工作台
APP_DESCRIPTION=面向小说创作者的 AI 创作台：世界设定、大纲、角色、章节写作与全书导出。
BRAND_PRIMARY_COLOR=#4D8088
BRAND_ACCENT_COLOR=#C08A6A
BRAND_FOOTER_NOTE=基于 MuMuAINovel 修改 · GPL v3
UPSTREAM_NAME=MuMuAINovel
UPSTREAM_URL=https://github.com/xiamuceer-j/MuMuAINovel
LICENSE_NAME=GPL-3.0
LICENSE_URL=https://www.gnu.org/licenses/gpl-3.0.html
AI_CONTENT_NOTICE=本站生成内容由 AI 辅助完成，请在发布或商用前进行人工审校。

# ==========================================
# PostgreSQL 数据库
# ==========================================
POSTGRES_DB=ai_novel
POSTGRES_USER=ainovel
POSTGRES_PASSWORD=change-me-in-env
POSTGRES_PORT=5432

# ==========================================
# 本地账户登录（首个管理员）
# ==========================================
LOCAL_AUTH_ENABLED=true
LOCAL_AUTH_USERNAME=admin
LOCAL_AUTH_PASSWORD=change-me-in-env
LOCAL_AUTH_DISPLAY_NAME=本地管理员

# ==========================================
# 会话与密钥
# ==========================================
# 生产环境务必替换为高强度随机值，例如：openssl rand -hex 32
SESSION_SECRET_KEY=
CREDENTIAL_ENCRYPTION_KEY=
SESSION_EXPIRE_MINUTES=120
SESSION_REFRESH_THRESHOLD_MINUTES=30
# 通过 HTTPS 访问时设为 true
SESSION_COOKIE_SECURE=false

# ==========================================
# 模型服务商（用户也可在设置页按账号配置自己的 Key）
# ==========================================
DEFAULT_AI_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=32000
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ==========================================
# 上游云服务与更新日志
# ==========================================
# 云端提示词工坊/云端公告默认关闭，公告使用本地数据
CLOUD_SERVICES_ENABLED=false
CHANGELOG_ENABLED=true
CHANGELOG_REPO_OWNER=hjm222222
CHANGELOG_REPO_NAME=MuMuAINovel

# ==========================================
# 调试
# ==========================================
DEBUG=false
