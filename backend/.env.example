# ==========================================
# AI 小说创作台 配置文件示例
# ==========================================
# 复制此文件为 .env 并修改配置值
# cp .env.example .env

# ==========================================
# 应用配置
# ==========================================
APP_NAME=AI 小说创作台
APP_VERSION=1.5.8
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
TZ=Asia/Shanghai

# 品牌配置
APP_SLOGAN=只做创作台的自托管 AI 小说工作台
APP_DESCRIPTION=面向小说创作者的 AI 创作台：世界设定、大纲、角色、章节写作与全书导出。
BRAND_PRIMARY_COLOR=#4D8088
BRAND_ACCENT_COLOR=#C08A6A
BRAND_FOOTER_NOTE=基于 MuMuAINovel 修改 · GPL v3
UPSTREAM_NAME=MuMuAINovel
UPSTREAM_URL=https://github.com/xiamuceer-j/MuMuAINovel
LICENSE_NAME=GPL-3.0
LICENSE_URL=https://www.gnu.org/licenses/gpl-3.0.html
AI_CONTENT_NOTICE=本站生成内容由 AI 辅助完成，请在发布或商用前进行人工审校。

# ==========================================
# PostgreSQL 数据库配置
# ==========================================

# PostgreSQL 连接信息
POSTGRES_DB=mumuai_novel
POSTGRES_USER=mumuai
POSTGRES_PASSWORD=123456
POSTGRES_PORT=5432

# 数据库连接 URL（Docker 部署时自动生成）
# DATABASE_URL=postgresql+asyncpg://mumuai:123456@localhost:5432/mumuai_novel

# ==========================================
# SQLite 数据库配置
# ==========================================

# DATABASE_URL=sqlite+aiosqlite:///data/ai_story.db

# ==========================================
# 日志配置
# ==========================================
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_FILE_PATH=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=30

# ==========================================
# CORS 配置
# ==========================================
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# ==========================================
# 全局代理配置（可选，会影响遵循环境变量的网络请求）
# ==========================================
# HTTP_PROXY=http://your-proxy:port
# HTTPS_PROXY=http://your-proxy:port
# NO_PROXY=localhost,127.0.0.1

# ==========================================
# AI 服务配置（至少配置一个）
# ==========================================

# OpenAI 配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Xiaomi MiMo 内置适配器（OpenAI 兼容格式）
# 注意：不要把真实 Key 提交到代码仓库；请只在本地 .env 或部署环境变量中配置
XIAOMI_MIMO_API_KEY=your_xiaomi_mimo_api_key_here
XIAOMI_MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# 默认 AI 配置
DEFAULT_AI_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=32000

# 本地 / Docker 内网 LLM（Ollama、llama.cpp、host.docker.internal）
# 默认关闭，保持 SSRF 防护。仅在本机或受信任网络部署时启用。
# ALLOW_PRIVATE_AI_ENDPOINTS=true
# ALLOWED_AI_HOSTS=host.docker.internal,127.0.0.1

# ==========================================
# 站点地址
# ==========================================
FRONTEND_URL=http://localhost:8090

# ==========================================
# 本地账户登录配置
# ==========================================
LOCAL_AUTH_ENABLED=true
LOCAL_AUTH_USERNAME=admin
LOCAL_AUTH_PASSWORD=admin123
LOCAL_AUTH_DISPLAY_NAME=本地管理员

# ==========================================
# 会话配置
# ==========================================
SESSION_EXPIRE_MINUTES=120
SESSION_REFRESH_THRESHOLD_MINUTES=30
# 会话签名密钥，生产环境必须配置为高强度随机值
SESSION_SECRET_KEY=
# 用户自带 API Key 的加密密钥，生产环境必须配置为高强度随机值
# 生成方式：openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=
# 会话 Cookie 是否强制 Secure：留空按 DEBUG 自动判断；HTTP 部署可设为 false
# SESSION_COOKIE_SECURE=false

# ==========================================
# SMTP 默认配置（可在系统设置中被管理员覆盖）
# ==========================================
SMTP_PROVIDER=qq
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=your-email@qq.com
SMTP_PASSWORD=your-qq-smtp-auth-code
SMTP_USE_TLS=false
SMTP_USE_SSL=true
SMTP_FROM_EMAIL=your-email@qq.com
SMTP_FROM_NAME=AI 小说创作台
EMAIL_AUTH_ENABLED=true
EMAIL_REGISTER_ENABLED=true
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10
EMAIL_VERIFICATION_RESEND_INTERVAL_SECONDS=60

# ==========================================
# 云端服务与更新日志
# ==========================================
# 本项目为独立部署，默认关闭对上游云服务的调用，公告使用本地数据
CLOUD_SERVICES_ENABLED=false

# LinuxDO OAuth 登录（独立部署默认关闭）
LINUXDO_ENABLED=false

# 更新日志来源（默认指向本 fork 仓库）
CHANGELOG_ENABLED=true
CHANGELOG_REPO_OWNER=hjm222222
CHANGELOG_REPO_NAME=MuMuAINovel
